---
const values = [
  [
    {
      ref: '01',
      name: 'Excellence',
      description:
        'We take pride in doing our best work every time. From design to communication, we pay attention to every detail to make sure our clients get real quality and lasting results.',
    },
    {
      ref: '02',
      name: 'Innovation',
      description:
        'We believe great ideas come from collaboration. Our team works closely with each client, combining creativity, skill, and feedback to turn ideas into something impactful.',
    },
  ],
  [
    {
      ref: '03',
      name: 'Teamwork',
      description:
        'We’re always exploring new tools, trends, and technologies to stay ahead. Every project is a chance to try something fresh and build smarter solutions for modern businesses.',
    },
    {
      ref: '04',
      name: 'Respect',
      description:
        'We treat our clients, team, and work with honesty and care. Respect shapes how we communicate, make decisions, and deliver — building relationships that last.',
    },
  ],
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-8 lg:gap-12">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Our Values</h2>
      <div class="grid gap-8 lg:grid-cols-2">
        {
          values.map((column, index) => (
            <div class:list={['space-y-8', index === 1 && 'lg:mt-16']}>
              {column.map((value) => (
                <div class="bg-primary-500/10 dark:bg-primary-400/10 flex flex-col gap-12 rounded-3xl px-6 py-8">
                  <p class="text-sm">{value.ref}</p>
                  <div class="flex flex-col gap-4">
                    <h3 class="text-xl font-medium">{value.name}</h3>
                    <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
                      {value.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
