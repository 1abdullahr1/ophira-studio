---
const stats = [
  {
    name: 'Years',
    value: '2',
  },
  {
    name: 'Experts',
    value: '5',
  },
  {
    name: 'Projects',
    value: '12',
  },
  {
    name: 'Awards',
    value: '2',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <img
        class="mx-auto h-auto w-full max-w-xl rounded-3xl"
        width="576"
        height="864"
        src="/assets/about.webp"
        alt="Our experts working together"
      />
      <div class="flex flex-col gap-10">
        <!-- Mission description -->
        <div class="space-y-8 sm:space-y-12">
          <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Our mission</h2>
          <div class="space-y-6">
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              At Ophira Studio, our mission is to help businesses build a strong and meaningful online presence. We focus on creating websites and marketing strategies that reflect each brand’s identity while delivering measurable results.
            </p>
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              We believe good design should do more than look appealing — it should communicate clearly, engage people, and drive growth. Every project we work on is built around these principles, combining creativity with strategy.
            </p>
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              Our goal is to build long-term partnerships based on trust, understanding, and shared success. We aim to be more than just a service provider — we want to be a reliable creative partner in your business journey.
            </p>
          </div>
        </div>

        <!-- Stats -->
        <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            stats.map((stat) => (
              <div class="border-primary-900/10 dark:border-primary-300/10 rounded-3xl border p-6">
                <dt class="text-base">{stat.name}</dt>
                <dd class="text-3xl font-medium tracking-tight">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
